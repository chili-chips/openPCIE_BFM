<mxCell id="c1" value="&lt;b&gt;PIPExN__pcieVHost: pcieVHost on a PIPE link, x1 or x4, Gen1 or Gen2&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="40" as="geometry" /></mxCell>
<mxCell id="c5" value="PIPExN__pcieVHost.sv: NodeNum, EndPoint (0 RC, 1 EP), Lanes (1 or 4), DataWidth (8 to 64), DllBytes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fffaeb;strokeColor=#d6b656;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="70" width="1020" height="560" as="geometry" /></mxCell>
<mxCell id="c6" value="pcieVHostPipexN.sv: after upstream's pcieVHostPipex1, for N lanes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fffaeb;strokeColor=#d6b656;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="115" width="720" height="360" as="geometry" /></mxCell>
<mxCell id="c7" value="&lt;b&gt;PcieVhost&lt;/b&gt; (pcieVHost.sv)&lt;br&gt;&lt;br&gt;Clk = pcieclk: 250 MHz Gen1, 500 MHz Gen2&lt;br&gt;notReset&lt;br&gt;LinkWidth = Lanes&lt;br&gt;&lt;br&gt;LinkOut0..N-1 [9:0]&lt;br&gt;LinkIn0..N-1 [9:0]&lt;br&gt;&lt;br&gt;TlpTx*, TlpRx*, DllpTx*, DllpRx*" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#6666ff;strokeColor=#3333cc;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="160" width="300" height="290" as="geometry" /></mxCell>
<mxCell id="c8" value="&lt;b&gt;PIPE to symbols&lt;/b&gt;, per lane&lt;br&gt;bits 7:0 a byte, bit 8 the K flag&lt;br&gt;(the model sends unencoded, unscrambled symbols)&lt;br&gt;DataWidth/8 symbols per pclk" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="160" width="280" height="170" as="geometry" /></mxCell>

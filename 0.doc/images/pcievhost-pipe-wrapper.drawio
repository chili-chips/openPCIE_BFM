<mxCell id="c10" value="&lt;b&gt;Clocks&lt;/b&gt;&lt;br&gt;pcieclk from pclk and gen2;&lt;br&gt;pclk = pcieclk / (DataWidth/8)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="350" width="280" height="100" as="geometry" /></mxCell>
